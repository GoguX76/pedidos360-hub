# Credenciales del broker RabbitMQ (clúster Pedidos360)
# Copiar este archivo como ".env" en la EC2 y completar los valores.
# JAMÁS versionar el .env real (contiene secretos).

# Erlang cookie compartida: es lo que permite a los nodos del clúster
# reconocerse como pares. Usar un valor largo y aleatorio.
RABBITMQ_ERLANG_COOKIE=change-me-largo-y-aleatorio

# Usuario/contraseña que los microservicios usarán para conectar por AMQP
# (y para la Management UI en :15672).
RABBITMQ_USER=pedidos
RABBITMQ_PASS=change-me-fuerte